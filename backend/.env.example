# Backend Entycollab - Variables de Entorno
# Copia este archivo a .env y completa los valores

# Servidor
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Base de datos (Prisma)
# Supabase → Project Settings → Database → Connection string → URI
# Usa la conexión directa o el "Session pooler" (puerto 5432).
# Si tu contraseña tiene caracteres especiales, codifícala para URL (@ -> %40, # -> %23, etc.).
DATABASE_URL=postgresql://postgres.tu-proyecto:TU_PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres
# Solo se usa con `prisma migrate dev` (base de datos temporal para detectar drift).
SHADOW_DATABASE_URL=postgresql://postgres.tu-proyecto:TU_PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres

# Supabase (nueva nomenclatura)
SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SECRET_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_JWKS_URL=https://tu-proyecto.supabase.co/auth/v1/.well-known/jwks.json

# Supabase (nomenclatura clásica / compatibilidad)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# JWT (para tokens propios si los necesitas)
JWT_SECRET=tu-secreto-super-seguro-cambia-en-produccion
JWT_EXPIRES_IN=7d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100