# Backend Entycollab - Variables de Entorno
# Copia este archivo a .env y completa los valores

# Servidor
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173,http://[::1]:5173

# Base de datos (Prisma)
# Supabase → Project Settings → Database → Connection string → URI
# Usa la conexión directa o el "Session pooler" (puerto 5432).
# Si tu contraseña tiene caracteres especiales, codifícala para URL (@ -> %40, # -> %23, etc.).
DATABASE_URL=postgresql://postgres.tu-proyecto:TU_PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres

# Supabase (solo backend: URL y service_role/secret key)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SECRET_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100